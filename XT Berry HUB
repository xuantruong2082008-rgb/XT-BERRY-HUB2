-- HÀM THỰC THI CHỨC NĂNG
-- ========================================================
local function TweenTo(targetCFrame, speed)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local dist = (hrp.Position - targetCFrame.Position).Magnitude
	local tween = TweenService:Create(hrp, TweenInfo.new(dist / (speed or 320), Enum.EasingStyle.Linear), {CFrame = targetCFrame})
	tween:Play()
	return tween
end

local function ExecuteButtonAction(id)
	if id == "CloseUI" then
		gui:Destroy()
	elseif id == "ToggleLang" then
		-- Đổi ngôn ngữ qua lại VN <-> EN
		State.Language = (State.Language == "VN") and "EN" or "VN"
		ReloadControls()
		showTab(currentTabName)
		notify(State.Language == "VN" and "Đã đổi sang Tiếng Việt!" : "Switched to English!")
	elseif id == "AntiAFK" then
		player.Idled:Connect(function()
			VirtualUser:CaptureController()
			VirtualUser:ClickButton2(Vector2.new())
		end)
		notify(State.Language == "VN" and "Đã bật chống AFK!" or "Anti-AFK Activated!")
	elseif id == "TpSafeZone" then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = hrp.CFrame * CFrame.new(0, 500, 0)
			notify(State.Language == "VN" and "Đã bay lên khu vực an toàn!" or "Teleported to Safe Sky!")
		end
	elseif id == "RandomFruit" then
		pcall(function()
			ReplicatedStorage.Remotes.CommF_:InvokeServer("Cousin", "Buy")
			notify(State.Language == "VN" and "Đã gửi yêu cầu quay trái ngẫu nhiên!" or "Requested Random Fruit!")
		end)
	elseif id == "Rejoin" then
		game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
	end
end

