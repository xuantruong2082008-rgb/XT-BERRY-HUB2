	desc.TextColor3 = COLORS.Muted
	desc.TextSize = 10
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextTruncate = Enum.TextTruncate.AtEnd

	if info.type == "toggle" then
		local isEnabled = State[info.id] or false
		local toggle = Instance.new("TextButton", row)
		toggle.Size = UDim2.fromOffset(76, 29)
		toggle.Position = UDim2.new(1, -88, 0.5, -14)
		toggle.BackgroundColor3 = isEnabled and COLORS.Green or COLORS.Off
		toggle.Text = isEnabled and "ON" or "OFF"
		toggle.TextColor3 = COLORS.Text
		toggle.TextSize = 11
		toggle.Font = Enum.Font.GothamBold
		Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

		toggle.MouseButton1Click:Connect(function()
			State[info.id] = not State[info.id]
			local current = State[info.id]
			toggle.Text = current and "ON" or "OFF"
			local target = current and COLORS.Green or COLORS.Off
			toggle.BackgroundColor3 = target
			notify(realName .. (current and " [ON]" or " [OFF]"))
		end)
	else
		local button = Instance.new("TextButton", row)
		button.Size = UDim2.fromOffset(100, 30)
		button.Position = UDim2.new(1, -112, 0.5, -15)
		button.BackgroundColor3 = COLORS.BlueDark
		button.Text = "RUN"
		button.TextColor3 = COLORS.Text
		button.TextSize = 11
		button.Font = Enum.Font.GothamBold
		Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

		button.MouseButton1Click:Connect(function()
			ExecuteButtonAction(info.id)
		end)
	end
end

showTab = function(tabName)
	currentTabName = tabName
	pageTitle.Text = tabName
	clearItems()
	local list = controls[tabName] or {}
	for _, info in ipairs(list) do
		makeRow(info)
	end
	if #list == 0 then
		local empty = Instance.new("TextLabel", itemScroll)
		empty.Size = UDim2.new(1, -4, 0, 54)
		empty.BackgroundColor3 = COLORS.Panel2
		empty.BorderSizePixel = 0
		empty.Font = Enum.Font.Gotham
		empty.Text = (State.Language == "VN") and ("Module [" .. tabName .. "] đang được phát triển.") or ("Module [" .. tabName .. "] coming soon.")
		empty.TextColor3 = COLORS.Muted
		empty.TextSize = 12
		Instance.new("UICorner", empty).CornerRadius = UDim.new(0, 8)
	end
	for _, child in ipairs(tabScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child.BackgroundColor3 = (child.Name == tabName) and COLORS.BlueDark or COLORS.Panel2
		end
	end
end

